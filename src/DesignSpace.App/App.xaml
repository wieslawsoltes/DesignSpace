<Application x:Class="DesignSpace.App.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:Microsoft.UI.Xaml.Controls"
 RequestedTheme="Dark">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><controls:XamlControlsResources /></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#2D2D30" />
   <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#252526" />
