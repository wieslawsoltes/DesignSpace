<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(DesignSpaceTargetFrameworks)' != ''">$(DesignSpaceTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType><UnoSingleProject>true</UnoSingleProject><UnoFeatures>SkiaRenderer</UnoFeatures>
    <ApplicationTitle>DesignSpace</ApplicationTitle><ApplicationId>com.wieslawsoltes.designspace</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion>
    <Description>Independent Blend-style XAML design environment with reusable Uno controls.</Description>
    <IsPackable>false</IsPackable><IsUiAutomationMappingEnabled>true</IsUiAutomationMappingEnabled>
    <WasmShellMonoRuntimeExecutionMode>Interpreter</WasmShellMonoRuntimeExecutionMode><WasmShellEnableThreading>false</WasmShellEnableThreading>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'"><DefineConstants>$(DefineConstants);__WASM__</DefineConstants></PropertyGroup>
  <ItemGroup><ProjectReference Include="../DesignSpace.Workbench.Uno/DesignSpace.Workbench.Uno.csproj" /></ItemGroup>
  <ItemGroup><TrimmerRootAssembly Include="DesignSpace.App;DesignSpace.Core;DesignSpace.Engine;DesignSpace.Animation;DesignSpace.Xaml;DesignSpace.Rendering.Skia;DesignSpace.Docking.Uno;DesignSpace.Controls.Uno;DesignSpace.Workbench.Uno" /></ItemGroup>
</Project>
