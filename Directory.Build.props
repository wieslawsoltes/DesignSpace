<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version><Authors>Wiesław Šoltés</Authors><Company>DesignSpace contributors</Company>
    <RepositoryUrl>https://github.com/wieslawsoltes/DesignSpace</RepositoryUrl><RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression><PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>xaml;designer;uno;blend;skia</PackageTags><PublishRepositoryUrl>true</PublishRepositoryUrl>
    <DebugType>embedded</DebugType><Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup><None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" /><None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
